# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Calendar API v3 (서버 전용, 공개 캘린더 read-only)
# https://console.cloud.google.com/ → APIs & Services → Library → Google Calendar API 활성화
# → Credentials → CREATE CREDENTIALS → API key
# 권장: Restrict key → Google Calendar API만 허용
GOOGLE_CALENDAR_API_KEY=your-api-key

# 대회 접수 API (cert-manager / golineup.kr)
NEXT_PUBLIC_CERT_API_BASE=https://golineup.kr

# ── 2026 양양 서핑캠프 접수 (surfcamp) ──────────────────────────────
# SOLAPI (로마드협동조합 계정 · cert-manager / lomad-homepage 공용)
# ※ 값 끝에 줄바꿈·공백이 붙으면 HMAC 서명이 깨져 전건 HTTP 400 이 난다.
#   복사·붙여넣기 시 개행이 따라붙지 않는지 반드시 확인할 것.
SOLAPI_API_KEY=your-solapi-api-key
SOLAPI_API_SECRET=your-solapi-api-secret
SOLAPI_SENDER=01095423775
# 알림톡 템플릿 심사 통과 후에만 채널 ID 를 넣는다. 비어 있으면 일반 SMS 로 폴백.
SOLAPI_KAKAO_CHANNEL_ID=
# 로컬 개발 전용. true 면 실제 발송 없이 콘솔 로그만. 운영에는 설정하지 말 것.
SOLAPI_TEST_MODE=true

# 본인인증(OTP) 코드 해시 + 세션 쿠키 서명용 페퍼.
# 운영에서 미설정이면 부팅에 실패한다(빈 값으로 HMAC 하면 쿠키 위조가 가능해짐).
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SURFCAMP_OTP_SECRET=your-64-hex-secret
# OTP 발송 레이트리밋의 IP 해시 솔트
SURFCAMP_IP_SALT=your-32-hex-salt
# 접수 관리자 페이지(/apply/surf-camp/admin) 비밀번호.
# ※ 이 비밀번호가 관리자 세션 쿠키의 HMAC 키이기도 하다 — 변경하면 기존 세션이 모두 무효화된다.
SURFCAMP_ADMIN_PASSWORD=change-me
